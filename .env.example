# ==========================================================
#  Kafka Streaming Pipeline - environment variables
#
#  Copy this file to .env:   cp .env.example .env
#  .env is ignored by git: it may hold secrets.
#
#  IMPORTANT: no trailing comments on a line, Docker Compose's
#  dotenv parser would include them in the value.
# ==========================================================

# ---------- Kafka (single broker, KRaft mode) ----------
# The docker service name = the broker address AS SEEN FROM the containers
KAFKA_INTERNAL_HOST=kafka
KAFKA_INTERNAL_PORT=9092
# Port exposed on YOUR machine (Python clients started from the host)
KAFKA_HOST_PORT=9092
# KRaft cluster id: a base64 UUID (22 chars) generated by kafka-storage.sh
# random-uuid. It must stay FIXED, otherwise the broker rejects its existing storage.
KAFKA_CLUSTER_ID=55bSTJM8SVWp9FTl0cBMPw
# Broker JVM memory. This machine is busy, so keep it modest.
KAFKA_HEAP="-Xmx768m -Xms768m"
# Message retention: 168h = 7 days
KAFKA_RETENTION_HOURS=168

# ---------- Kafka UI (observability: topics, partitions, offsets, lag) ----------
KAFKA_UI_PORT=8085

# ---------- PostgreSQL (analytics destination) ----------
POSTGRES_USER=stream_user
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=streaming_analytics
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Port exposed on YOUR machine (5432 / 5433 / 5434 / 5440 are already taken)
POSTGRES_HOST_PORT=5441

# ---------- Ownership of the files written under data/ ----------
# The Kafka segments are bind-mounted into data/kafka: they must belong to you
# on the host to stay readable and deletable.
HOST_UID=1000
HOST_GID=1000

# ---------- Spark (phase 8: Structured Streaming) ----------
# Master UI (8080/8081/8082/8090/8091 are already taken by the other projects)
SPARK_MASTER_UI_PORT=8092
# Worker UI
SPARK_WORKER_UI_PORT=8093
# Application UI: the "Structured Streaming" tab lives here (4040 is taken)
SPARK_APP_UI_PORT=4041
# Worker resources. Kafka, its UI and PostgreSQL already run on this machine.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G
